# URL do backend FastAPI. Se não definida, o app roda em modo demo
# (dados mock locais, igual ao protótipo mockup/index.html).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Só necessárias se o app precisar falar com o Supabase diretamente
# (hoje toda a integração passa pelo backend acima).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
