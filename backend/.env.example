# URL e chaves do projeto Supabase (Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# String de conexão direta ao Postgres (Settings > Database), se precisar de SQL cru
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Usada para assinar tokens internos da API (não confundir com o JWT secret do Supabase)
SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# Origens permitidas para CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:8081,exp://127.0.0.1:19000
